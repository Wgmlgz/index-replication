POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable
WEB_HOST=app123.localhost
TRAEFIK_PORT=30000
JWT_SECRET=
COOKIE_DOMAIN=
TERRAFORM_VERSION=1.7.5
KEYCLOAK_VERSION=26.1
KEYCLOAK_PORT=18081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HTTP_RELATIVE_PATH=/auth
KEYCLOAK_THEME_NAME=index-replication
KEYCLOAK_REALM=index-replication
KEYCLOAK_REALM_DISPLAY_NAME=Index Replication
KEYCLOAK_DB_SCHEMA=keycloak
# Optional auto-created user for first login/testing
KEYCLOAK_BOOTSTRAP_USER=
KEYCLOAK_BOOTSTRAP_USER_PASSWORD=
KEYCLOAK_BOOTSTRAP_USER_EMAIL=
# API Keycloak token verification settings
KEYCLOAK_AUTH_ENABLED=true
# Base URL used by API to fetch OIDC metadata (compose defaults to internal Keycloak URL)
KEYCLOAK_BASE_URL=http://localhost:18081/auth
# Optional override for API container (defaults to http://keycloak:8080/auth in docker-compose)
KEYCLOAK_API_BASE_URL=
# Optional explicit issuer URL override; default is ${KEYCLOAK_BASE_URL}/realms/${KEYCLOAK_REALM}
KEYCLOAK_ISSUER_URL=
# Optional audience check target; leave empty to skip by default
KEYCLOAK_CLIENT_ID=
KEYCLOAK_SKIP_ISSUER_CHECK=true
KEYCLOAK_SKIP_CLIENT_ID_CHECK=true
# Frontend auth mode / OIDC (build-time vars for web image)
NEXT_PUBLIC_AUTH_MODE_DEFAULT=session
NEXT_PUBLIC_KEYCLOAK_BASE_URL=/auth
NEXT_PUBLIC_KEYCLOAK_REALM=index-replication
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=web
# Optional path or absolute URL for silent renew callback page
NEXT_PUBLIC_KEYCLOAK_SILENT_REDIRECT_URI=

# Most static Keycloak Terraform values are kept in infra/terraform/keycloak defaults.
# Add TF_VAR_* in compose only for values that actually change per environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLL_TIMEOUT_SEC=30
LOGIN_VERIFICATION_TTL_SECONDS=300
MOEX_BASE_URL=https://iss.amogos.pro/iss
MOEX_MUTABLE_DAYS=30
MOEX_IMMUTABLE_BEFORE_DATE=
MOEX_LIVE_CURRENT_DAY_ENABLED=false
MOEX_ENABLE_MONTHLY_DEEP_RESYNC=false
MOEX_SCHEDULE_TIMEZONE=Europe/Moscow
TBANK_INVEST_GRPC_ENDPOINT=invest-public-api.tbank.ru:443
TBANK_INVEST_SANDBOX_GRPC_ENDPOINT=sandbox-invest-public-api.tbank.ru:443
# Optional override; default auto-detects api/certs/tbank-root-ca.pem
TBANK_CA_CERT_FILE=
TEMPORAL_VERSION=1.30.1
TEMPORAL_UI_VERSION=2.47.2
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=moex-sync
TEMPORAL_TASK_QUEUE=moex-sync
TEMPORAL_ENABLE_SEARCH_ATTRIBUTES=false
