POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable
WEB_HOST=app123.localhost
TRAEFIK_PORT=30000
JWT_SECRET=
COOKIE_DOMAIN=
KEYCLOAK_PORT=18081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Optional external Keycloak hostname/base URL used for generated absolute URLs
# (set this behind TLS-terminating proxy, for example: https://replicant.amogos.pro/auth).
KEYCLOAK_HOSTNAME=
KEYCLOAK_WEB_REDIRECT_URIS=http://localhost:3000/login*,http://localhost:30000/login*,http://localhost:3000/auth/silent-callback,http://localhost:30000/auth/silent-callback
KEYCLOAK_WEB_ORIGINS=http://localhost:3000,http://localhost:30000
KEYCLOAK_ADMIN_PROXY_CLIENT_SECRET=change-me
# Comma-separated list passed to Terraform as TF_VAR_keycloak_admin_proxy_redirect_uris.
KEYCLOAK_ADMIN_PROXY_REDIRECT_URIS=http://localhost:30000/oauth2/callback,http://app123.localhost:30000/oauth2/callback
# oauth2-proxy cookie secret (base64-encoded 32-byte value)
ADMIN_AUTH_COOKIE_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Optional explicit oauth2-proxy callback URL. Set this to HTTPS behind TLS-terminating proxy.
# Example: https://replicant.amogos.pro/oauth2/callback
OAUTH2_PROXY_REDIRECT_URL=
# Set true when browser traffic is HTTPS.
OAUTH2_PROXY_COOKIE_SECURE=false
# Optional auto-created user for first login/testing
KEYCLOAK_BOOTSTRAP_USER=
KEYCLOAK_BOOTSTRAP_USER_PASSWORD=
KEYCLOAK_BOOTSTRAP_USER_EMAIL=
# API Keycloak token verification settings
# Base URL used by API to fetch OIDC metadata (compose defaults to internal Keycloak URL)
KEYCLOAK_BASE_URL=http://localhost:18081/auth
# Optional override for API container (defaults to http://keycloak:8080/auth in docker-compose)
KEYCLOAK_API_BASE_URL=
# Optional explicit issuer URL override; default is ${KEYCLOAK_BASE_URL}/realms/index-replication
KEYCLOAK_ISSUER_URL=
# Frontend OIDC (build-time vars for web image)
NEXT_PUBLIC_KEYCLOAK_BASE_URL=/auth
NEXT_PUBLIC_KEYCLOAK_REALM=index-replication
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=web
# Path or absolute URL for silent renew callback page
NEXT_PUBLIC_KEYCLOAK_SILENT_REDIRECT_URI=/auth/silent-callback

# Most static Keycloak Terraform values are kept in infra/terraform/keycloak defaults.
# Add TF_VAR_* in compose only for values that actually change per environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLL_TIMEOUT_SEC=30
LOGIN_VERIFICATION_TTL_SECONDS=300
MOEX_BASE_URL=https://iss.amogos.pro/iss
MOEX_MUTABLE_DAYS=30
MOEX_IMMUTABLE_BEFORE_DATE=
MOEX_LIVE_CURRENT_DAY_ENABLED=false
MOEX_ENABLE_MONTHLY_DEEP_RESYNC=false
MOEX_SCHEDULE_TIMEZONE=Europe/Moscow
TBANK_INVEST_GRPC_ENDPOINT=invest-public-api.tbank.ru:443
TBANK_INVEST_SANDBOX_GRPC_ENDPOINT=sandbox-invest-public-api.tbank.ru:443
# Optional override; default auto-detects api/certs/tbank-root-ca.pem
TBANK_CA_CERT_FILE=
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=moex-sync
TEMPORAL_TASK_QUEUE=moex-sync
TEMPORAL_ENABLE_SEARCH_ATTRIBUTES=false
